{
  "name": "portfolio-video-keynote",
  "private": true,
  "type": "module",
  "description": "\"Keynote\" — 30 s Apple-keynote-style portfolio film for Soham Jadhav (HyperFrames + GSAP + Three.js).",
  "scripts": {
    "dev": "npx --yes hyperframes@0.8.114 preview",
    "check": "npx --yes hyperframes@0.8.114 check",
    "snapshot": "npx --yes hyperframes@0.8.114 snapshot --at 1.8,4.5,8.9,10.8,13.8,16.5,21.2,25.3,27.2,29.95 --no-end -o out/snapshots",
    "render": "npx --yes hyperframes@0.8.114 render --quality looks --fps 60 --output renders/soham-keynote-16x9.mp4",
    "render:draft": "npx --yes hyperframes@0.8.114 render --quality draft --fps 30 --output out/draft.mp4",
    "audio": "python3 scripts/synth_audio.py",
    "vendor": "node scripts/vendor.mjs",
    "typeface": "node scripts/make-typeface.mjs",
    "postinstall": "node scripts/vendor.mjs",
    "publish": "npx --yes hyperframes@0.8.114 publish"
  },
  "devDependencies": {
    "@fontsource/geist-mono": "5.3.0",
    "@fontsource/geist-sans": "5.3.0",
    "gsap": "3.14.2",
    "opentype.js": "1.3.4",
    "three": "0.184.0"
  }
}
