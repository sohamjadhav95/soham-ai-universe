{
  "name": "portfolio-video",
  "private": true,
  "type": "module",
  "description": "\"Heartbeat Signal\" — 15 s motion-graphic portfolio film for Soham Jadhav (HyperFrames + GSAP + Three.js).",
  "scripts": {
    "dev": "npx --yes hyperframes@0.8.114 preview",
    "check": "npx --yes hyperframes@0.8.114 check",
    "snapshot": "npx --yes hyperframes@0.8.114 snapshot --at 1.25,3.3,5.95,6.7,7.9,9.9,10.85,12.9,14.6 --no-end -o out/snapshots",
    "render": "npx --yes hyperframes@0.8.114 render --quality delivery --fps 60 --output renders/soham-portfolio-16x9.mp4",
    "render:draft": "npx --yes hyperframes@0.8.114 render --quality draft --fps 30 --output out/draft.mp4",
    "audio": "python3 scripts/synth_audio.py",
    "vendor": "node scripts/vendor.mjs",
    "typeface": "node scripts/make-typeface.mjs",
    "postinstall": "node scripts/vendor.mjs",
    "publish": "npx --yes hyperframes@0.8.114 publish"
  },
  "devDependencies": {
    "@fontsource/archivo-black": "5.2.8",
    "@fontsource/fraunces": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.2.7",
    "gsap": "3.14.2",
    "opentype.js": "1.3.4",
    "three": "0.184.0"
  }
}
